{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL", "STOOD_TEST_TIMEOUT_MS", "STOOD_UI_MAX_WORKERS"],
  "tasks": {
    "test": { "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["YARD_UI_COVERAGE"] }
  }
}
