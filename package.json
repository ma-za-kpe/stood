{
  "name": "stood",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @stood/yard-domain build && pnpm --filter @stood/yard-contracts build && tsc --noEmit && turbo run typecheck",
    "build": "turbo run build",
    "lint": "biome check .",
    "boundary": "depcruise --config .dependency-cruiser.cjs services packages apps",
    "validate": "pnpm lint && pnpm typecheck && pnpm boundary && pnpm test:coverage && pnpm build",
    "test:db": "vitest run --config vitest.db.config.ts --coverage",
    "test:mock:stood": "vitest run --config vitest.db.config.ts services/api/test/mock-flow.db.test.ts",
    "test:mock:network": "vitest run --config vitest.network.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.12.0",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
