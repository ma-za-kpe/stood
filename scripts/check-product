#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "${STOOD_SKIP_PRODUCT_LINT:-0}" = 1 ]; then
  # CI runs Biome in the independent pre-commit lane; its aggregate gate requires both lanes to pass.
  docker compose run --rm app pnpm validate:product
else
  docker compose run --rm app pnpm validate
fi
docker compose run --rm app node --test scripts/affected-integration.test.mjs
scripts/check-migrations
docker compose run --rm app node --test tools/site/serve.test.mjs tools/site/check-portal.test.mjs
docker compose up -d --wait db
scripts/check-openapi
scripts/check-sdk
exec docker compose run --rm app pnpm test:db
