#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
# Git sets these during a commit. The pinned upstream hook runs git in its
# own checkout to discover its release and cache directory, so isolate it.
exec env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR \
  pre-commit run lychee --config .pre-commit-links.yaml --files "$@"
