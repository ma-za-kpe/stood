#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "$#" -eq 0 ]; then set -- validate; fi
case "$1" in
  setup) shift; exec docker compose run --rm -it app sh -c 'pnpm --filter @stood/api build && node services/api/dist/setup-cli.js "$@"' setup "$@" ;;
  reconcile) exec docker compose --profile operations run --rm reconciler ;;
  yard-setup)
    # T-0214, once: Yard's restricted roles on the database named by DATABASE_URL, and Yard's settings in .env.
    # Generated values go straight into .env; nothing is printed. Safe to re-run: existing values are kept.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    db=$(grep -E '^DATABASE_URL=' .env | tail -1 | cut -d= -f2-)
    [ -n "$db" ] || { echo "DATABASE_URL is empty in .env" >&2; exit 2; }
    has() { grep -qE "^$1=.+" .env; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    if ! has YARD_DATABASE_URL; then
      password=$(openssl rand -hex 24)
      printf 'YARD_ENV=demo\nYARD_MIGRATION_DATABASE_URL=%s\nYARD_RUNTIME_PASSWORD=%s\n' "$db" "$password" >"$keys"
      docker compose run --rm --no-deps --env-from-file "$keys" app \
        sh -c 'pnpm --filter "@stood/yard-api..." build >/dev/null && node services/yard-api/dist/db-cli.js roles && node services/yard-api/dist/db-cli.js migrate'
      runtime=$(DB="$db" PW="$password" node -e 'const u=new URL(process.env.DB);u.username="yard_runtime";u.password=process.env.PW;process.stdout.write(u.toString())')
      printf 'YARD_DATABASE_URL=%s\nYARD_MIGRATION_DATABASE_URL=%s\n' "$runtime" "$db" >>.env
    fi
    has YARD_SECRET_KEYS || printf 'YARD_SECRET_KEYS=k1:%s\n' "$(openssl rand -base64 32)" >>.env
    if ! has YARD_OPERATORS; then
      printf 'YARD_OPERATORS=[{"key":"yard-buyer","secret":"%s","actor":{"id":"buyer","root":"buyer-operator","kind":"BUYER"}},{"key":"yard-builder","secret":"%s","actor":{"id":"crew","root":"crew-operator","kind":"BUILDER"}}]\n' \
        "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" >>.env
    fi
    echo "Yard roles ready and YARD_DATABASE_URL, YARD_MIGRATION_DATABASE_URL, YARD_SECRET_KEYS, YARD_OPERATORS set in .env." ;;
  yard-access-codes)
    # T-0266: give each Yard operator an access code for signing in on the hosted page. Codes go into
    # YARD_OPERATORS in .env and, for the owner to read, into ~/.config/stood/yard-access-codes (mode 600).
    # Nothing is printed. Existing codes are kept; copy YARD_OPERATORS to Render afterwards.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    mkdir -p "$HOME/.config/stood"
    python3 -I - .env "$HOME/.config/stood/yard-access-codes" <<'PY'
import json, os, secrets, sys
env_path, codes_path = sys.argv[1], sys.argv[2]
lines = open(env_path, encoding="utf-8").read().splitlines()
index = next(i for i, line in enumerate(lines) if line.startswith("YARD_OPERATORS="))
operators = json.loads(lines[index].split("=", 1)[1])
for operator in operators:
    operator.setdefault("accessCode", secrets.token_urlsafe(24))
lines[index] = "YARD_OPERATORS=" + json.dumps(operators, separators=(",", ":"))
with open(env_path, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines) + "\n")
fd = os.open(codes_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as handle:
    for operator in operators:
        handle.write(f"{operator['actor']['kind'].lower()}: {operator['accessCode']}\n")
print(f"Access codes set for {len(operators)} operators. Read them in {codes_path} (owner only).")
PY
    ;;
  runner-key)
    # T-0159: create the code runner's Ed25519 signing key straight into .env, never printed. Refuses to replace an
    # existing key unless asked: `scripts/dev runner-key --rotate` (reports signed with the old key stop verifying).
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    if grep -qE '^RUNNER_SIGNING_KEY=.+' .env && [ "${2:-}" != "--rotate" ]; then
      echo "RUNNER_SIGNING_KEY already exists. Use: scripts/dev runner-key --rotate" >&2; exit 2
    fi
    key=$(docker compose run --rm --no-deps -T app node -e "const { generateKeyPairSync } = require('node:crypto'); process.stdout.write(Buffer.from(generateKeyPairSync('ed25519').privateKey.export({ type: 'pkcs8', format: 'pem' })).toString('base64'))")
    [ -n "$key" ] || { echo "Key generation failed" >&2; exit 1; }
    id="runner-$(date +%Y-%m-%d)"
    for f in .env "$HOME/.config/stood/.env"; do
      [ -f "$f" ] || continue
      next=$(mktemp); chmod 600 "$next"
      grep -vE '^RUNNER_(KEY_ID|SIGNING_KEY)=' "$f" >"$next" || true
      printf 'RUNNER_KEY_ID=%s\nRUNNER_SIGNING_KEY=%s\n' "$id" "$key" >>"$next"
      cat "$next" >"$f" && rm -f "$next" && chmod 600 "$f"   # writes through a symlinked .env
    done
    echo "Saved RUNNER_KEY_ID=$id and RUNNER_SIGNING_KEY to .env (not printed)." ;;
  runner-check)
    # T-0164: qualify the isolated runner on real Vercel Sandbox (ADR-0026). Only the caller's Vercel settings reach
    # this container; none of them enter the microVM.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(VERCEL_TOKEN|VERCEL_TEAM_ID|VERCEL_PROJECT_ID)=' .env >"$keys" || true
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      sh -c 'pnpm --filter @stood/api build >/dev/null && node services/api/dist/runner-check-cli.js' ;;
  preview-check)
    # T-0196: qualify live previews on Render: one free-plan service from a digest-pinned public image, always deleted.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(RENDER_API_KEY|RENDER_OWNER_ID)=' .env >"$keys" || true
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      sh -c 'pnpm --filter "@stood/yard-api..." build >/dev/null && node services/yard-api/dist/preview-check-cli.js' ;;
  github-check)
    # T-0188: qualify the Yard Builder GitHub App on the sandbox repository (throwaway branch, main untouched).
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keyfile=$(grep -E '^GITHUB_APP_PRIVATE_KEY_PATH=' .env | cut -d= -f2-)
    [ -f "$keyfile" ] || { echo "GITHUB_APP_PRIVATE_KEY_PATH does not point to a file" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(GITHUB_APP_ID|GITHUB_APP_INSTALLATION_ID|YARD_SANDBOX_REPOSITORY)=' .env >"$keys" || true
    printf 'GITHUB_APP_PRIVATE_KEY_BASE64=%s\n' "$(base64 <"$keyfile" | tr -d '\n')" >>"$keys"
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      sh -c 'pnpm --filter "@stood/yard-api..." build >/dev/null && node services/yard-api/dist/github-check-cli.js' ;;
  planner-check)
    # T-0221: qualify the live Grok planner against the shared contract (five drafts, about $0.05; capped at $0.20).
    # Only GROK_PLANNER_API_KEY (and an optional GROK_PLANNER_MODEL) reach the container.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(GROK_PLANNER_API_KEY|GROK_PLANNER_MODEL)=' .env >"$keys" || true
    printf 'GROK_PLANNER_LIVE=1\n' >>"$keys"
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      pnpm exec vitest run services/yard-foreman/src/planner-contract.test.ts -t 'grok live' ;;
  vault-key)
    # T-0227: put a new saved-token key first in VAULT_TOKEN_KEYS in .env. The key is never printed.
    [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    current=$(grep -E '^VAULT_TOKEN_KEYS=' .env | tail -1 | cut -d= -f2-)
    last=$(printf '%s' "$current" | tr ',' '\n' | sed -n 's/^v\([0-9]*\):.*/\1/p' | sort -n | tail -1)
    next="v$(( ${last:-0} + 1 )):$(openssl rand -base64 32)"
    tmp=$(mktemp); chmod 600 "$tmp"
    grep -vE '^VAULT_TOKEN_KEYS=' .env >"$tmp"
    printf 'VAULT_TOKEN_KEYS=%s\n' "$next${current:+,$current}" >>"$tmp"
    cat "$tmp" >.env; rm -f "$tmp"
    echo "Added ${next%%:*} as the newest key in .env. Run scripts/dev vault-rotate, then copy VAULT_TOKEN_KEYS to Render." ;;
  vault-rotate)
    # Re-seal saved tokens under the newest key. Only DATABASE_URL and VAULT_TOKEN_KEYS reach the container.
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(DATABASE_URL|VAULT_TOKEN_KEYS)=' .env >"$keys" || true
    printf 'APP_ENV=demo\n' >>"$keys"
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      sh -c 'pnpm --filter @stood/api build >/dev/null && node services/api/dist/vault-keys-cli.js rotate' ;;
  findings)
    # Reconciliation findings in the database named by .env (T-0257). Only DATABASE_URL reaches the container.
    shift; [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^DATABASE_URL=' .env >"$keys" || true
    printf 'APP_ENV=demo\n' >>"$keys"
    docker compose run --rm --no-deps --env-from-file "$keys" app \
      sh -c 'pnpm --filter @stood/api build >/dev/null && node services/api/dist/findings-cli.js "$@"' findings "$@" ;;
  sandbox-run)
    # Only the sandbox app keys reach the container, from a private temporary file (T-0224).
    shift; [ -f .env ] || { echo "Create .env first (cp .env.example .env)" >&2; exit 2; }
    keys=$(mktemp); chmod 600 "$keys"; trap 'rm -f "$keys"' EXIT
    grep -E '^(PAYPAL_CLIENT_ID|PAYPAL_CLIENT_SECRET|STOOD_SANDBOX_PAYEE_ID|PAYPAL_SANDBOX_VAULT_TOKEN_ID|KERNEL_API_KEY|PAYPAL_SANDBOX_BUYER_EMAIL|PAYPAL_SANDBOX_BUYER_PASSWORD)=' .env >"$keys" || true
    docker compose run --rm --env-from-file "$keys" app \
      sh -c 'pnpm --filter @stood/api build >/dev/null && node services/api/dist/sandbox-run-cli.js "$@"' sandbox-run "$@"
    # vault-setup leaves the saved payment token in .sandbox/; move it into .env (never printed), then delete it.
    if [ -s .sandbox/vault-token ]; then
      token=$(cat .sandbox/vault-token); rm -f .sandbox/vault-token
      for f in .env "$HOME/.config/stood/.env"; do
        [ -f "$f" ] || continue
        next=$(mktemp); chmod 600 "$next"
        grep -v '^PAYPAL_SANDBOX_VAULT_TOKEN_ID=' "$f" >"$next" || true
        printf 'PAYPAL_SANDBOX_VAULT_TOKEN_ID=%s\n' "$token" >>"$next"
        cat "$next" >"$f" && rm -f "$next" && chmod 600 "$f"   # writes through a symlinked .env
      done
      echo "Saved PAYPAL_SANDBOX_VAULT_TOKEN_ID to .env. Next: scripts/dev sandbox-run vault-release"
    fi ;;
  site)
    docker compose run --rm app sh -c 'pnpm --filter @stood/yard-domain build && pnpm --filter @stood/yard-web build && npm ci --prefix tools/site && node tools/site/build.mjs'
    exec docker compose --profile site up -d --wait site ;;
  up) exec docker compose up -d db s3 mail ;;
  install) exec docker compose run --rm app pnpm install --frozen-lockfile ;;
  validate) exec scripts/check-product ;;
  test:db)
    docker compose up -d --wait db
    exec docker compose run --rm app pnpm test:db ;;
  demo) exec scripts/mock-network --keep ;;
  demo:down) exec docker compose -p stood-demo -f compose.mock.yaml -f compose.demo.yaml down --volumes --remove-orphans --rmi local ;;
  mock)
    exec scripts/mock-network ;;
  mock:integration)
    docker compose up -d --wait db
    exec docker compose run --rm app pnpm test:mock:stood ;;
  *) exec docker compose run --rm app pnpm "$@" ;;
esac
