#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ "$#" -eq 0 ]; then set -- validate; fi
case "$1" in
  setup) shift; exec docker compose run --rm -it app sh -c 'pnpm --filter @stood/api build && node services/api/dist/setup-cli.js "$@"' setup "$@" ;;
  reconcile) exec docker compose --profile operations run --rm reconciler ;;
  site)
    docker compose run --rm app sh -c 'pnpm --filter @stood/yard-domain build && pnpm --filter @stood/yard-web build && npm ci --prefix tools/site && node tools/site/build.mjs'
    exec docker compose --profile site up -d --wait site ;;
  up) exec docker compose up -d db s3 mail ;;
  install) exec docker compose run --rm app pnpm install --frozen-lockfile ;;
  validate) exec scripts/check-product ;;
  test:db)
    docker compose up -d --wait db
    exec docker compose run --rm app pnpm test:db ;;
  mock)
    exec scripts/mock-network ;;
  mock:integration)
    docker compose up -d --wait db
    exec docker compose run --rm app pnpm test:mock:stood ;;
  *) exec docker compose run --rm app pnpm "$@" ;;
esac
