#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
keep=false
case "${1:-}" in
  "") project="stood-mock-$(date +%s)-$$" ;;
  --keep) keep=true; project=stood-demo ;;
  *) printf '%s\n' 'Usage: scripts/mock-network [--keep]' >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then exit 2; fi
compose() {
  if [ "$keep" = true ]; then
    docker compose -p "$project" -f compose.mock.yaml -f compose.demo.yaml "$@"
  else
    docker compose -p "$project" -f compose.mock.yaml "$@"
  fi
}
if [ "$keep" = true ] && [ -n "$(compose ps --all --quiet)" ]; then
  printf '%s\n' 'A demo stack already exists. Use scripts/dev demo:down before reseeding it.' >&2
  exit 2
fi
finish() {
  result=$?
  trap - EXIT INT TERM
  if [ "$result" -ne 0 ]; then
    mkdir -p artifacts/mock-network
    compose logs --no-color > artifacts/mock-network/services.log 2>&1 || true
    compose logs --no-color --tail 40 || true
  fi
  if [ "$keep" = true ] && [ "$result" -eq 0 ]; then
    printf '%s\n' 'Simulated demo ready: http://localhost:3002/ (Stood), /yard/ (Yard), /yard/app/?project=yard-project (connected room).' 'No real payment is executed. Stop with scripts/dev demo:down.'
    exit 0
  fi
  compose down --volumes --remove-orphans --rmi local >/dev/null 2>&1 || true
  exit "$result"
}
trap finish EXIT INT TERM
compose build runner
compose run --rm runner pnpm install --frozen-lockfile
compose run --rm runner node --test tools/site/serve.test.mjs
compose run --rm runner scripts/build-mock
compose run --rm runner sh -c 'npm ci --prefix tools/site && node tools/site/build.mjs'
docker build -f tools/site/Dockerfile.test -t stood-site-browser .
mkdir -p artifacts/mock-network
compose up -d --wait --wait-timeout 120 db paypal-sim api yard-api crew web
compose run --rm runner pnpm test:mock:network
compose run --rm browser

if [ "$keep" = true ]; then
  for path in / /yard/ '/yard/app/?project=yard-project'; do
    curl --fail --silent --show-error "http://127.0.0.1:3002$path" >/dev/null
  done
fi
