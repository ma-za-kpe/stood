# Stood local configuration. Names and safe defaults only: never put values in Git.
# Copy to .env (gitignored), then `chmod 600 .env`. Sandbox only: never a live PayPal app.
# Full guide: docs/SETUP.md (hosted sandbox) and docs/HANDOFF.md (key inventory and scopes).

# ---- Runtime
APP_ENV=local
DEMO_MODE=false
# sim = the local PayPal simulator (no keys needed); live = the real PayPal SANDBOX.
PROVIDER_PAYPAL=sim
STOOD_PLATFORM_ID=local-platform

# ---- PayPal sandbox app (Developer Dashboard > Sandbox > Apps & Credentials, type Merchant)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After the first deploy: webhook on https://<stood-api>/v1/webhooks/paypal (docs/SETUP.md section 6).
PAYPAL_WEBHOOK_ID=

# Sandbox runs (scripts/dev sandbox-run): the US business account that receives the payment.
# Its public Account ID from Sandbox > Accounts > View/Edit account > Profile. Not a secret.
STOOD_SANDBOX_PAYEE_ID=
# Saved PayPal payment token from `scripts/dev sandbox-run vault-setup` (a standing permission to charge the
# sandbox buyer). Written here by scripts/dev; never commit it or put it in a recording.
PAYPAL_SANDBOX_VAULT_TOKEN_ID=
# A generated sandbox test card (developer.paypal.com > Sandbox > Card testing). Fake; sandbox only.
PAYPAL_SANDBOX_TEST_CARD_NUMBER=
PAYPAL_SANDBOX_TEST_CARD_EXPIRY=
PAYPAL_SANDBOX_TEST_CARD_CVC=

# ---- Postgres (Neon, eu-central-1). Use the DIRECT (unpooled) URL with sslmode=verify-full: Stood uses LISTEN,
# and outside local/ci Stood refuses anything weaker (docs/SETUP.md section 4).
DATABASE_URL=

# ---- Stood's own signing keys. `scripts/dev setup` generates them (256-bit, shown once).
STOOD_API_KEY=
STOOD_HMAC_SECRET=
STOOD_WEBHOOK_SECRET=

# ---- Yard planner model (xAI Grok). Project key with a hard spend limit; server-side only.
# The live adapter is not built yet (T-0181); the scripted planner is used until then.
GROK_PLANNER_API_KEY=

# ---- Yard GitHub App (Developer settings > GitHub Apps). Install on selected test repositories only.
# Permissions: Contents read/write, Pull requests read/write, Metadata read. No org or admin access.
GITHUB_APP_ID=
# Path to the private key (.pem), kept outside every repository with mode 600.
GITHUB_APP_PRIVATE_KEY_PATH=
# Only once the app webhook is on (Yard deployed).
GITHUB_APP_WEBHOOK_SECRET=

# ---- Reconciliation worker: who owns its alerts (a name, not a secret)
RECONCILIATION_OWNER=

# ---- Hosting: Render API key, so tooling can set service variables (the Render CLI cannot)
RENDER_API_KEY=

# ---- Evidence storage (S3-compatible, e.g. Cloudflare R2). Not read by the running code yet.
# Use a bucket and a token scoped to Stood only.
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RECEIPT_SIGNING_KEY=

# ---- Planned integrations (not read by the running code yet)
EVIDENCE_AGENT_URL=
EVIDENCE_AGENT_TOKEN=
WORKERS_AI_TOKEN=
CHANNEL3_API_KEY=
KERNEL_API_KEY=

# Not here: PAYPAL_SANDBOX_ACCESS_TOKEN belongs in ~/.claude/settings.json for the
# PayPal AI Toolkit MCP server only (docs/tech/T16-paypal-ai-toolkit.md).

# T-0227: keys that seal saved PayPal tokens at rest (AES-256-GCM). Newest first. Create with `scripts/dev vault-key`
# (writes here, never prints); rotate with `scripts/dev vault-rotate`. Set the same value on Render when Vault is live.
VAULT_TOKEN_KEYS=

# Yard on Render (T-0214). Written by `scripts/dev yard-setup`; copy to the stood-yard-api service.
YARD_DATABASE_URL=
YARD_MIGRATION_DATABASE_URL=
YARD_SECRET_KEYS=
YARD_OPERATORS=
